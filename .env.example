# ==============================================================================
# ReviewMind — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for local execution.
# Never commit a real .env file containing credentials or sensitive paths to Git.
# ==============================================================================

# Project Directories (Relative paths from project root)
REVIEWMIND_DATA_DIR=data
REVIEWMIND_MODELS_DIR=models
REVIEWMIND_REPORTS_DIR=reports

# Reproducibility Seed
RANDOM_SEED=42

# Feature Extraction Settings
TFIDF_MAX_FEATURES=20000
TFIDF_NGRAM_MIN=1
TFIDF_NGRAM_MAX=2

# Multinomial Naive Bayes Hyperparameters
NB_ALPHA=0.1
NB_FIT_PRIOR=false

# External Prediction Settings
LOW_CONFIDENCE_THRESHOLD=0.60

